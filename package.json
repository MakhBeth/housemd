{
  "name": "housemd",
  "version": "0.1.0",
  "private": true,
  "description": "Editor markdown nel browser per cartelle locali, stile HackMD",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "tsx --test",
    "bridge": "node bridge/claude-bridge.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:audit": "playwright test -c e2e/audit.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "minisearch": "^7.2.0",
    "pixelarticons": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-pattern": "5.9.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
